# Build artifacts (may contain local absolute paths)
*.egg-info/

# Secrets and local auth — never commit
.env
.env.*
.env_*
*.env
!.env.example
.envrc
.flaskenv
.netrc
.pypirc

# pyicloud writes <apple-id>.cookiejar and <apple-id>.session
# inside ICLOUD_SESSION_DIR (defaults off-repo under XDG).
session/
cookies/
cookiejar/
*.cookiejar
*.session
*.cookies
*.cookie
cookies.txt

# Keys / certs that sometimes land next to a login helper
*.pem
*.key
*.p8
*.p12
*.pfx
*.p7b
*.keystore
id_rsa
id_ed25519
id_ecdsa

# Generic secret filenames
*.secret
*.secrets
secrets.yaml
secrets.yml
credentials.json
auth.json

# Downloaded iCloud files (ICLOUD_DOWNLOAD_DIR override)
downloads/
state/
cache/

# If someone points XDG_* or session/download dirs at the repo
.local/
.cache/

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
dist/
build/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Editors / OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
