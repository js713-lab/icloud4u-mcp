# Apple ID used by the MCP server and the login CLI. There is no default.
ICLOUD_USERNAME=

# Optional. `icloud-docs-mcp login` prompts on a TTY if this is unset.
# Do not commit this value. Prefer the login command over putting a
# password in the MCP process environment.
# ICLOUD_PASSWORD=

# Optional overrides. Defaults are XDG data/cache directories.
# ICLOUD_SESSION_DIR=
# ICLOUD_DOWNLOAD_DIR=

# Optional Drive path prefix. All tools are scoped under this folder.
# Example: Documents/Work
# ICLOUD_ROOT=
